---
import { site, withBase } from "../data/site";

const current = Astro.url.pathname.replace(/\/$/, "") || "/";
---

<nav class="site-nav" aria-label="目録">
  {
    site.nav.map((item) => {
      const href = withBase(item.href);
      const hrefPath = href.replace(/\/$/, "") || "/";
      const isCurrent =
        current === hrefPath || current.startsWith(`${hrefPath}/`);
      return (
        <a href={href} aria-current={isCurrent ? "page" : undefined}>
          {item.label}
        </a>
      );
    })
  }
</nav>
