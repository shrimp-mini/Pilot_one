---
import { site } from "../data/site";

const current = Astro.url.pathname.replace(/\/$/, "") || "/";
---

<nav class="site-nav" aria-label="目録">
  {
    site.nav.map((item) => {
      const hrefPath = item.href.replace(/\/$/, "") || "/";
      const isCurrent =
        current === hrefPath || current.startsWith(`${hrefPath}/`);
      return (
        <a href={item.href} aria-current={isCurrent ? "page" : undefined}>
          {item.label}
        </a>
      );
    })
  }
</nav>
